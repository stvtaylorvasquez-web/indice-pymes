table m_e4_alerta_temprana
	lineageTag: 2fa6356d-355c-470e-8d4c-810c08cc0530

	measure 'Empresas evaluadas' = COUNTROWS(m_e4_alerta_temprana)
		formatString: #,0
		displayFolder: Alerta
		lineageTag: a8ca8248-ed9b-5bfa-ac60-73ea5519cb90

	measure 'Alerta muy alta' = CALCULATE(COUNTROWS(m_e4_alerta_temprana), m_e4_alerta_temprana[nivel_alerta] = "Muy alta (>15%)")
		formatString: #,0
		displayFolder: Alerta
		lineageTag: 4c57c3ce-e2ce-52e9-bfc9-127f80a83d0c

	measure 'Prob. promedio de caer' = AVERAGE(m_e4_alerta_temprana[prob_caer_distress_siguiente_anio])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Alerta
		lineageTag: 3294eddd-5b2c-5d9a-a6a3-c1bfe6f3f270


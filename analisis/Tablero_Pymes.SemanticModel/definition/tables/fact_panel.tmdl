table fact_panel
	lineageTag: 7471ef46-a371-4e48-b5b7-2b7b34f72ed0

	measure Empresas = DISTINCTCOUNT(fact_panel[nit])
		formatString: #,0
		displayFolder: Conteos
		lineageTag: dc3d6ffb-5e78-5b24-a5c1-8372a2218c2d

	measure Empresas-año = COUNTROWS(fact_panel)
		formatString: #,0
		displayFolder: Conteos
		lineageTag: 36af0608-3033-5ebd-acc2-55ac455e5971

	measure '% Distress' = DIVIDE(CALCULATE(COUNTROWS(fact_panel), fact_panel[zona] = "Distress Zone"), CALCULATE(COUNTROWS(fact_panel), fact_panel[zona] IN {"Distress Zone", "Gray Zone", "Safe Zone"}))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Z Altman
		lineageTag: 240e5320-02a4-5855-8f77-27a8b6b951c4

	measure '% Gray' = DIVIDE(CALCULATE(COUNTROWS(fact_panel), fact_panel[zona] = "Gray Zone"), CALCULATE(COUNTROWS(fact_panel), fact_panel[zona] IN {"Distress Zone", "Gray Zone", "Safe Zone"}))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Z Altman
		lineageTag: 3f5bf033-07cc-5378-9980-28dbe7418ff0

	measure '% Safe' = DIVIDE(CALCULATE(COUNTROWS(fact_panel), fact_panel[zona] = "Safe Zone"), CALCULATE(COUNTROWS(fact_panel), fact_panel[zona] IN {"Distress Zone", "Gray Zone", "Safe Zone"}))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Z Altman
		lineageTag: 8a63ad06-f025-50f3-add3-cd50ae908a41

	measure 'Z mediano' = MEDIAN(fact_panel[z])
		formatString: 0.00
		displayFolder: Z Altman
		lineageTag: 54afc87b-85b3-574d-8689-b25927c65865

	measure 'Razón corriente mediana' = MEDIAN(fact_panel[cr])
